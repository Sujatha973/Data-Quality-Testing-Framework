{
  "data_asset_type": null,
  "expectation_suite_name": "orders_suite",
  "expectations": [
    {
      "expectation_type": "expect_table_row_count_to_be_between",
      "kwargs": { "min_value": 1 },
      "meta": { "notes": "Table should never be empty." }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "order_id" },
      "meta": { "notes": "Primary key must never be null." }
    },
    {
      "expectation_type": "expect_column_values_to_be_unique",
      "kwargs": { "column": "order_id" },
      "meta": { "notes": "Primary key must be unique." }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "customer_id" },
      "meta": { "notes": "Every order must reference a customer." }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "amount",
        "min_value": 0,
        "strict_min": false
      },
      "meta": { "notes": "Order amounts must never be negative." }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "status" },
      "meta": { "notes": "Order status should always be set." }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "status",
        "value_set": ["placed", "shipped", "delivered", "cancelled", "returned"]
      },
      "meta": { "notes": "Status must be one of the known lifecycle values." }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "order_date" },
      "meta": { "notes": "Order date should always be recorded." }
    }
  ],
  "ge_cloud_id": null,
  "meta": {
    "great_expectations_version": "0.18.19"
  }
}
